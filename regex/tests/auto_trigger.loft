// Tier-1 trigger: the text-method form with NO `use regex;`.  The parser
// auto-loads regex via its declared `[triggers] enabled` — the `matches` /
// `search` / `split_on` text-methods derived from this package's source.
// The two `#superseded` spellings `find` / `split` ARE shadowed by the stdlib
// `text` methods of the same name — that is precisely why `search` / `split_on`
// exist and why those two are superseded.  Asserting the warning rather than
// suppressing it: if the shadow ever disappears (the superseded pair removed, or
// the stdlib method renamed) this annotation goes red and asks to be deleted.
// It does couple THIS SUITE to a loft carrying `shadowed-by-method` (2026-08-16
// onward); the library's own runtime behaviour is unchanged, so the package's
// `loft` floor stays where it is.
// @EXPECT_WARNING: `find` is also a method on `text`
// @EXPECT_WARNING: `split` is also a method on `text`
fn main() {
  assert("abc123".matches("[0-9]+"), "matches auto-loads regex (no use)");
  assert(!"abcdef".matches("[0-9]+"), "no digits -> no match");
  assert("abc123".search("[0-9]+") == 3, "search auto-loads");
  out = "";
  for p in "a,b,c".split_on(",") {
    out = "{out}{p}.";
  }
  assert(out == "a.b.c.", "split_on auto-loads (got {out})");
}
