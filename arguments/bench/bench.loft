//
// bench — the performance pass: the package's `parse` door, timed on a fixed command line,
// with a hash of what it produced.
//
//     loft --interpret bench/bench.loft [--n N]         the interpreter
//     loft --native-release bench/bench.loft [--n N]    compiled
//     rustc -O --edition=2021 bench/bench.rs -o bench/.build/stats_rs   the Rust twin
//
// One tab-separated line per routine: name, iterations, total µs, ns per op, items one op
// processes, ns per item, and an FNV-1a-32 hash of one canonical op's output.  The hash is
// what makes a benchmark a VALIDATION: the interpreter, the native build and the pure-Rust
// twin in bench/bench.rs must print the same hash for a row, or one of them is not computing
// the routine it claims to — and only then does comparing their speeds mean anything.
//
// Every op builds its own command line from the repetition number `r`, and `r & 1` moves a
// value word — never the amount of work — so no backend can hoist an op out of the
// repetition loop.  Each op's result is folded into `sink`, printed on the last line.
use arguments;

/// One measured routine.
struct Row {
  name: text = "",
  iters: integer = 0,
  us: integer = 0,
  px: integer = 0,
  hash: integer = 0,
  sink: integer = 0,
}

const FNV_OFFSET = 2166136261;
const FNV_PRIME = 16777619;

const PARSES = 2000;

/// 40 options; the first 26 have the short names a..z.  Kind: F flag, V value, O optional.
const NAMES = "verbose quiet output input format level color config dry-run force recursive jobs timeout retry log-file log-level user group mode prefix suffix exclude include depth follow size since until sort reverse width height encoding locale cache-dir no-cache threads seed profile trace";
const KINDS = "FFVVVVOVFFFVVVVVVVOVVVVVFVVVOFVVVVVFVVOF";
const SHORTS = "abcdefghijklmnopqrstuvwxyz";

fn fnv_byte(h: integer, b: integer) -> integer {
  ((h ^ (b & 255)) * FNV_PRIME) & 0xFFFFFFFF
}

/// FNV-1a-32 over each byte of a text, then a 0 terminator.
fn fnv_text(h0: integer, t: text) -> integer {
  ft_h = h0;
  for ft_i in 0..size(t) { ft_h = fnv_byte(ft_h, t.byte_at(ft_i)); }
  fnv_byte(ft_h, 0)
}

fn print_row(r: const Row) {
  pr_ns = ((r.us * 1000) / r.iters) ?? 0;
  pr_px = if r.px > 0 { (((r.us * 1000) as float) / ((r.iters * r.px) as float)) ?? 0.0 }
          else { 0.0 };
  println("{r.name}\t{r.iters}\t{r.us}\t{pr_ns}\t{r.px}\t{pr_px:.3}\t{r.hash:x}");
}

/// The parser: 40 declared options, `format` required.
fn make_args() -> arguments::Args {
  ma_a = arguments::create("bench", "1.0", "argument parsing bench");
  ma_names = NAMES.split(' ');
  for ma_name in ma_names {
    ma_i = ma_name#count;
    ma_s = if ma_i < 26 { SHORTS[ma_i..ma_i + 1] } else { "" };
    ma_k = KINDS[ma_i..ma_i + 1];
    if ma_k == "F" {
      ma_a.flag(ma_s, ma_name, "flag {ma_name}");
    } else if ma_k == "O" {
      ma_a.optional(ma_s, ma_name, "ARG", "optional {ma_name}");
    } else if ma_name == "format" {
      ma_a.required(ma_s, ma_name, "FMT", "required {ma_name}");
    } else {
      ma_a.option(ma_s, ma_name, "VAL", "value {ma_name}");
    }
  }
  ma_a
}

/// The command line: 24 words covering every spelling the parser takes — exact long names,
/// `--name=value`, a unique prefix, short clusters, glued short values, an optional
/// option bare and with `=`, value words, and interspersed positionals.
fn make_argv(r: integer) -> vector<text> {
  mv_s = r & 1;
  ["--verbose", "--output", "out{mv_s}.bin", "--format=json", "--thr", "{8 + mv_s}", "-ab",
   "-l{4 + mv_s}", "-m", "3{mv_s}", "file{mv_s}.txt", "--color", "--mode=fast", "--recur",
   "--enc=utf{8 + mv_s}", "-kjy", "--log-level", "debug", "--since=2026-01-0{mv_s}",
   "--no-cache", "--seed", "1234{mv_s}", "second.txt", "--trace"]
}

fn parse_op(r: integer) -> integer {
  po_a = make_args();
  po_argv = make_argv(r);
  po_sink = 0;
  for _ in 0..PARSES {
    if po_a.parse(po_argv) { po_sink += 1; }
    po_sink += len(po_a.positionals) + size(po_a.get_or("seed", ""));
  }
  po_sink
}

/// The hash of one parse: its answer, every option's value (null as a 1 byte), and the
/// positionals in order.
fn parse_hash() -> integer {
  ph_a = make_args();
  ph_ok = ph_a.parse(make_argv(0));
  ph_h = fnv_byte(FNV_OFFSET, if ph_ok { 1 } else { 0 });
  for ph_name in NAMES.split(' ') {
    ph_v = ph_a.get(ph_name);
    if ph_v == null { ph_h = fnv_byte(ph_h, 1); } else { ph_h = fnv_text(ph_h, ph_v ?? ""); }
  }
  for ph_p in ph_a.positionals { ph_h = fnv_text(ph_h, ph_p); }
  ph_h
}

fn bench_parse(n: integer) -> Row {
  bp_t0 = ticks();
  bp_sink = 0;
  for r in 0..n { bp_sink += parse_op(r); }
  bp_us = ticks() - bp_t0;
  Row { name: "parse", iters: n, us: bp_us, px: PARSES * 24, hash: parse_hash(), sink: bp_sink }
}

fn main(mn_args: vector<text>) {
  mn_n = 20;
  mn_i = 0;
  while mn_i < len(mn_args) {
    if mn_args[mn_i]? == "--n" && mn_i + 1 < len(mn_args) {
      mn_n = (mn_args[mn_i + 1]? as integer?)?;
      mn_i += 1;
    }
    mn_i += 1;
  }
  if mn_n < 1 { mn_n = 1; }
  mn_t0 = ticks();
  println("routine\titers\tus\tns_op\tpx\tns_px\thash");
  mn_rows: vector<Row> = [bench_parse(mn_n)];
  mn_sink = 0;
  for row in mn_rows {
    print_row(row);
    mn_sink += row.sink;
  }
  println("time: {(ticks() - mn_t0) / 1000}ms sink={mn_sink}");
}
