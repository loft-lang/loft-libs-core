// --- Random ---
// Random number generation functions.

// Returns a random integer in [lo, hi] (inclusive).
// Returns null when lo > hi or when either argument is null.
// Draws from the ONE hidden generator every call site shares — see `rand_seed`.
// Example: @RND-001 — why a seeded global sequence is not yours, and what a
// RandStream gives instead.
pub fn rand(lo: integer, hi: integer) -> integer? {
  if lo > hi { return null; }
  rand_raw(lo, hi)
}

// The draw itself, in C: lo + (next % (hi - lo + 1)); the empty range is answered above,
// because a null cannot cross the C boundary.
fn rand_raw(lo: integer, hi: integer) -> integer;
#c "lr_rand" "int64_t(int64_t, int64_t)"

// Seeds the shared random number generator with the given value.
// Call this before rand() or rand_indices() to get reproducible sequences — but
// note that it fixes what the GENERATOR produces, not what you receive: it is
// shared, so one `rand()` from anywhere else shifts everything after it.  When
// reproducibility is a requirement rather than a convenience, own a stream.
// Example: @RND-001 — a foreign draw between two of yours, and the same
// interruption against a RandStream.
pub fn rand_seed(seed: integer);
#c "lr_rand_seed" "void(int64_t)"

// The next draw of the shared generator reduced modulo m, in [0, m); 0 when m < 1.
// The step of a shuffle (`rand_indices`), published so a shuffle of your own draws
// the same sequence.
pub fn rand_below(m: integer) -> integer;
#c "lr_rand_below" "int64_t(int64_t)"

// Returns a vector of n integers [0, 1, ..., n-1] in a random order.
// Useful for random iteration, shuffling, or sampling without replacement.
// Returns an empty vector when n is 0, negative or null.
// Example: @RND-001 — this draws from the shared global generator too.
pub fn rand_indices(n: integer) -> vector<integer> {
  out: vector<integer> = [];
  if n <= 0 { return out; }
  for i in 0..n { out += [i]; }
  // Fisher-Yates from the top, one draw per position: the order the Rust part drew in.
  i = n - 1;
  while i > 0 {
    j = rand_below(i + 1);
    t = out[i] ?? 0;
    out[i] = out[j] ?? 0;
    out[j] = t;
    i -= 1;
  }
  out
}

// --- RandStream: owned random streams (the value tier) ---
//
// The global rand()/rand_seed() above share ONE hidden generator — right for casual
// use, wrong when the RNG is part of your STATE. A RandStream is an independent,
// deterministic stream you OWN: seed it, carry it (a plain struct — it saves, replays
// and syncs with your data), and draw from it without any other call site reordering
// your sequence. Typical uses: a game's per-level generation stream vs its combat
// stream; several simulations alive in one process; replay/lockstep determinism.
//
// Pure loft, no native: L'Ecuyer's (1988) combined LCG — two Lehmer streams over
// distinct primes via Schrage's method, combined. Period ~2.3e18, classical
// statistical quality, and every intermediate product stays far below loft's
// overflow-trapping 2^63.
//
// A struct parameter is a store link, so draws advance the stream through the
// default receiver — methods-way call sites:
//
//   r = seed_stream(7);
//   v = r.get(1, 6);          // a die roll from THIS stream
//   p = r.indices(52);        // a shuffled deck from THIS stream

// An independent random stream: the two Lehmer generator states.  Seed one with `seed_stream`
// and draw from it with its methods, so its sequence does not depend on any other draw in the
// program.
pub struct RandStream {
  pub s1: integer,   // Lehmer state A in [1, 2147483562]
  pub s2: integer,   // Lehmer state B in [1, 2147483398]
}

// Seed an independent stream. Any integer seed is valid (negative and zero included);
// equal seeds give equal streams, different seeds give decorrelated streams.
// Example: @RND-001 — the reason to prefer this over `rand_seed`.
// Example: @RND-003 — equal seeds replay exactly, so a recorded seed is a
// recorded run.
pub fn seed_stream(seed: integer) -> RandStream {
  a = seed % 2147483562 ?? 0;
  if a < 0 { a = -a; }
  t = seed % 2147483398 ?? 0;
  if t < 0 { t = -t; }
  // decorrelate s2 from s1 for small seeds with one cheap Lehmer-style mix
  mix = ((a + 1) * 40014) % 2147483563 ?? 0;
  RandStream { s1: a + 1, s2: ((t + mix) % 2147483398 ?? 0) + 1 }
}

// A random integer in [lo, hi] (inclusive) from THIS stream, advancing it.
// Returns null when lo > hi (the same contract as the global rand()).
// Example: @RND-002 — assigning a stream COPIES it, passing one to a function
// LINKS it, so a helper that draws spends the caller's sequence.
pub fn get(self: RandStream, lo: integer, hi: integer) -> integer? {
  if lo > hi { return null; }
  // L'Ecuyer combined LCG, Schrage's method (all products < 2^31 * 40692 — trap-safe)
  k1 = self.s1 / 53668 ?? 0;
  n1 = 40014 * (self.s1 - k1 * 53668) - k1 * 12211;
  if n1 < 0 { n1 += 2147483563; }
  k2 = self.s2 / 52774 ?? 0;
  n2 = 40692 * (self.s2 - k2 * 52774) - k2 * 3791;
  if n2 < 0 { n2 += 2147483399; }
  self.s1 = n1;
  self.s2 = n2;
  z = (n1 - n2) % 2147483562 ?? 0;
  if z < 1 { z += 2147483562; }
  lo + ((z - 1) % (hi - lo + 1) ?? 0)
}

// A random permutation of [0, 1, ..., n-1] from THIS stream (Fisher-Yates), advancing
// it by exactly n - 1 draws. Empty when n is 0, negative or null (the same contract
// as rand_indices()).
// Example: @RND-003 — a shuffle is a countable number of draws, so inserting one
// shifts the rest of the sequence by a known amount rather than adding noise.
pub fn indices(self: RandStream, n: integer) -> vector<integer> {
  out: vector<integer> = [];
  if !n { return out; }
  if n <= 0 { return out; }
  for i in 0..n { out += [i]; }
  j = n - 1;
  while j > 0 {
    k = get(self, 0, j) ?? 0;
    if k < len(out) && j < len(out) {
      t = out[j] ?? 0;
      out[j] = out[k] ?? 0;
      out[k] = t;
    }
    j -= 1;
  }
  out
}

// --- Rand32: the 32-bit tier ---
//
// For a 32-bit processor, and for a `#width 32` program, which reads `integer` as `i32`: draws
// that are `i32` and `single` from the start, computed in 32-bit arithmetic.  xoshiro128**
// (128 bits of state, shifts and xors) with Lemire's multiply-shift for a range — no 128-bit
// product and no 64-bit remainder, which the global tier pays on every draw and a 32-bit
// processor pays as a library call.  The same C part runs on every target, so a seed draws the
// same sequence everywhere.  A different generator from the global tier: a seed does not
// reproduce `rand`'s sequence.

// An owned 32-bit stream: assigning one copies it, passing one to a function links it, as a
// `RandStream` does.  Its state is opaque: sixteen bytes only the C part reads and writes.
pub struct Rand32 {
  st: vector<u8>,
}

fn x32_seed(st: vector<u8>, seed: integer);
#c "lr32_seed" "void(uint8_t*, int64_t)"
fn x32_range(st: vector<u8>, lo: i32, hi: i32) -> i32;
#c "lr32_range" "int32_t(uint8_t*, int32_t, int32_t)"
fn x32_bits31(st: vector<u8>) -> i32;
#c "lr32_bits31" "int32_t(uint8_t*)"
fn x32_unit(st: vector<u8>) -> single;
#c "lr32_unit" "float(uint8_t*)"
fn x32g_seed(seed: integer);
#c "lr32g_seed" "void(int64_t)"
fn x32g_range(lo: i32, hi: i32) -> i32;
#c "lr32g_range" "int32_t(int32_t, int32_t)"
fn x32g_unit() -> single;
#c "lr32g_unit" "float(void)"
fn x32_hw_seed() -> integer;
#c "lr32_hw_seed" "int64_t(void)"

// Seed an owned 32-bit stream.  Any seed is valid; equal seeds give equal streams, and
// different seeds give decorrelated ones (SplitMix64 spreads the seed over the state).
pub fn seed32(seed: integer) -> Rand32 {
  r = Rand32 { st: [0 as u8; 16] };
  x32_seed(r.st, seed);
  r
}

// A random `i32` in [lo, hi] (inclusive) from THIS stream, advancing it; null when lo > hi.
// Unbiased: every value of the range is equally likely.
pub fn get32(self: Rand32, lo: i32, hi: i32) -> i32? {
  if lo > hi { return null; }
  x32_range(self.st, lo, hi)
}

// The next 31 random bits of THIS stream, in [0, 2147483647].
pub fn bits31(self: Rand32) -> i32 {
  x32_bits31(self.st)
}

// A random `single` in [0, 1) from THIS stream: 24 random bits, all a single holds.
pub fn unit32(self: Rand32) -> single {
  x32_unit(self.st)
}

// A random permutation of [0, 1, ..., n-1] from THIS stream (Fisher-Yates), advancing it by
// exactly n - 1 draws.  Empty when n is 0 or negative.
pub fn indices32(self: Rand32, n: i32) -> vector<i32> {
  out: vector<i32> = [];
  if n <= 0 { return out; }
  // Every position is in [0, n), inside i32: the mask says so where this 64-bit file computes it.
  for i in 0..n { out += [i & 2147483647]; }
  j = n - 1;
  while j > 0 {
    k = x32_range(self.st, 0, j & 2147483647);
    t = out[j] ?? 0;
    out[j] = out[k] ?? 0;
    out[k] = t;
    j -= 1;
  }
  out
}

// A random `i32` in [lo, hi] from the shared 32-bit generator (seeded with 12345 at startup);
// null when lo > hi.  Shared like `rand`: any other call site's draw shifts your sequence.
pub fn rand32(lo: i32, hi: i32) -> i32? {
  if lo > hi { return null; }
  x32g_range(lo, hi)
}

// Seed the shared 32-bit generator.
pub fn rand32_seed(seed: integer) {
  x32g_seed(seed);
}

// A random `single` in [0, 1) from the shared 32-bit generator.
pub fn rand32_unit() -> single {
  x32g_unit()
}

// A seed from the platform's entropy — the hardware random number generator on the Tanmatsu
// (ESP-IDF), the operating system's elsewhere — for a run that is NOT meant to be reproduced:
// `seed32(seed_hw() ?? 1)`.  Null where the platform has no entropy source (the wasm builds).
pub fn seed_hw() -> integer? {
  v = x32_hw_seed();
  if v < 0 { return null; }
  v
}
