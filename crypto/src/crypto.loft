// --- Crypto ---
// Cryptographic primitives: SHA-256 and HMAC, base64, Ed25519 and ES256
// signatures, X25519 key agreement, HKDF, AES-256-GCM, a CSPRNG, and HPKE base
// mode built from them — over the vendored BearSSL and Monocypher, C99 the
// package ships and loft builds itself (`c/`).
//
// Bytes cross the API as standard base64 `text`.  Input that is not base64 is
// refused the way each function refuses anything malformed — "" or false, never
// a result computed from other bytes than the ones sent.

// --- The C part ---
//
// Two vendored, audited libraries carry the primitives — BearSSL (`c/vendor/bearssl`, MIT:
// SHA-256, HMAC, HKDF, AES-256-GCM, P-256 ECDSA with RFC 6979 nonces, X25519, all
// constant-time) and Monocypher (`c/vendor/monocypher`, BSD-2 / CC0: Ed25519) — behind the
// one-call entry points of `c/crypto_glue.c`.  loft builds them as the package's `[c] shim`
// for the host and for both wasm targets; no Rust crate, no bridge.  Bytes cross as
// `vector<u8>` buffers this side sizes (a pointer and, where the C signature has one, a
// count); each entry answers 1 for success and 0 for a refusal.  Base64 and hex are loft's,
// below.

fn c_sha256_text(data: text, out: vector<u8>) -> integer;
#c "cr_sha256_text" "int(const char*, void*)"
fn c_sha256(data: const vector<u8>, out: vector<u8>) -> integer;
#c "cr_sha256" "int(const void*, int64_t, void*)"
fn c_hmac_sha256_text(key: text, data: text, out: vector<u8>) -> integer;
#c "cr_hmac_sha256_text" "int(const char*, const char*, void*)"
fn c_hkdf_extract(salt: const vector<u8>, ikm: const vector<u8>, out: vector<u8>) -> integer;
#c "cr_hkdf_extract" "int(const void*, int64_t, const void*, int64_t, void*)"
fn c_hkdf_expand(prk: const vector<u8>, info: const vector<u8>, out: vector<u8>) -> integer;
#c "cr_hkdf_expand" "int(const void*, int64_t, const void*, int64_t, void*, int64_t)"
fn c_hkdf(salt: const vector<u8>, ikm: const vector<u8>, info: const vector<u8>, out: vector<u8>) -> integer;
#c "cr_hkdf" "int(const void*, int64_t, const void*, int64_t, const void*, int64_t, void*, int64_t)"
fn c_aes256gcm(encrypt: integer, key: const vector<u8>, nonce: const vector<u8>, aad: const vector<u8>, buf: vector<u8>, tag: vector<u8>) -> integer;
#c "cr_aes256gcm" "int(int, const void*, const void*, const void*, int64_t, void*, int64_t, void*)"
fn c_x25519(secret: const vector<u8>, public: const vector<u8>, out: vector<u8>) -> integer;
#c "cr_x25519" "int(const void*, const void*, void*)"
fn c_ed25519_public_key(seed: const vector<u8>, out: vector<u8>) -> integer;
#c "cr_ed25519_public_key" "int(const void*, void*)"
fn c_ed25519_sign(seed: const vector<u8>, message: const vector<u8>, out: vector<u8>) -> integer;
#c "cr_ed25519_sign" "int(const void*, const void*, int64_t, void*)"
fn c_ed25519_verify(public: const vector<u8>, message: const vector<u8>, signature: const vector<u8>) -> boolean;
#c "cr_ed25519_verify" "int(const void*, const void*, int64_t, const void*)"
fn c_p256_scalar_ok(d: const vector<u8>) -> boolean;
#c "cr_p256_scalar_ok" "int(const void*)"
fn c_p256_public_key(d: const vector<u8>, out: vector<u8>) -> integer;
#c "cr_p256_public_key" "int(const void*, void*)"
fn c_p256_sign(d: const vector<u8>, message: const vector<u8>, out: vector<u8>) -> integer;
#c "cr_p256_sign" "int(const void*, const void*, int64_t, void*)"
fn c_p256_verify(xy: const vector<u8>, message: const vector<u8>, signature: const vector<u8>) -> boolean;
#c "cr_p256_verify" "int(const void*, const void*, int64_t, const void*)"
fn c_random(out: vector<u8>) -> integer;
#c "cr_random" "int(void*, int64_t)"

// --- Bytes, base64 and hex, in loft ---

// `n` zero bytes: the buffer a C entry point fills.
fn zeros(n: integer) -> vector<u8> {
  [for _ in 0..n { 0 }]
}

// The UTF-8 bytes of a text.
fn text_bytes(t: text) -> vector<u8> {
  [for i in 0..size(t) { t.byte_at(i) }]
}

// Lowercase hex of a byte vector.
fn hex(bytes: const vector<u8>) -> text {
  digits = "0123456789abcdef";
  out = "";
  for b in bytes {
    hi = b / 16 ?? 0;
    lo = b % 16 ?? 0;
    out += digits[hi..hi + 1];
    out += digits[lo..lo + 1];
  }
  out
}

// Standard base64 with padding (RFC 4648 § 4).
fn b64_encode(bytes: const vector<u8>) -> text {
  chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
  out = "";
  n = len(bytes);
  i = 0;
  while i < n {
    b0 = bytes[i] ?? 0;
    b1 = if i + 1 < n { bytes[i + 1] ?? 0 } else { 0 };
    b2 = if i + 2 < n { bytes[i + 2] ?? 0 } else { 0 };
    v = b0 * 65536 + b1 * 256 + b2;
    c0 = (v / 262144 ?? 0) % 64 ?? 0;
    c1 = (v / 4096 ?? 0) % 64 ?? 0;
    c2 = (v / 64 ?? 0) % 64 ?? 0;
    c3 = v % 64 ?? 0;
    out += chars[c0..c0 + 1];
    out += chars[c1..c1 + 1];
    out += if i + 1 < n { chars[c2..c2 + 1] } else { "=" };
    out += if i + 2 < n { chars[c3..c3 + 1] } else { "=" };
    i += 3;
  }
  out
}

// Base64url without padding (RFC 4648 § 5), as JWTs spell it.
fn b64url_encode(bytes: const vector<u8>) -> text {
  out = "";
  for c in b64_encode(bytes) {
    if c == '+' { out += "-"; }
    else if c == '/' { out += "_"; }
    else if c != '=' { out += "{c}"; }
  }
  out
}

// The value of one base64 character, both alphabets; -1 for anything else.
fn b64_value(c: integer) -> integer {
  if c >= 65 && c <= 90 { return c - 65; }
  if c >= 97 && c <= 122 { return c - 97 + 26; }
  if c >= 48 && c <= 57 { return c - 48 + 52; }
  if c == 43 || c == 45 { return 62; }
  if c == 47 || c == 95 { return 63; }
  -1
}

// Standard or url-safe base64 decoded, padded or not, line breaks ignored: null when the text
// is not base64 (a stray character, padding that does not fill a quartet, a lone trailing
// sextet).  The rule the Rust part applied, so every caller's refusal stays where it was.
fn b64_decode(b64: text) -> vector<u8>? {
  vals: vector<integer> = [];
  pad = 0;
  for i in 0..size(b64) {
    c = b64.byte_at(i);
    if c == 10 || c == 13 { continue; }
    if c == 61 { pad += 1; continue; }
    if pad > 0 { return null; }
    v = b64_value(c);
    if v < 0 { return null; }
    vals += [v];
  }
  n = len(vals);
  if pad > 2 || (pad > 0 && (n + pad) % 4 != 0) || n % 4 == 1 { return null; }
  out: vector<u8> = [];
  i = 0;
  while i < n {
    v0 = vals[i] ?? 0;
    v1 = if i + 1 < n { vals[i + 1] ?? 0 } else { 0 };
    v2 = if i + 2 < n { vals[i + 2] ?? 0 } else { 0 };
    v3 = if i + 3 < n { vals[i + 3] ?? 0 } else { 0 };
    v = v0 * 262144 + v1 * 4096 + v2 * 64 + v3;
    out += [(v / 65536 ?? 0) % 256 ?? 0];
    if i + 2 < n { out += [(v / 256 ?? 0) % 256 ?? 0]; }
    if i + 3 < n { out += [v % 256 ?? 0]; }
    i += 4;
  }
  out
}

// Base64 decoded to exactly `n` bytes, or null: a key, a nonce or a signature of the wrong
// length is refused whole.
fn b64_fixed(b64: text, n: integer) -> vector<u8>? {
  bytes = b64_decode(b64);
  if bytes == null { return null; }
  if len(bytes) != n { return null; }
  bytes
}

// --- Public API ---

// SHA-256 hash of a string. Returns 64-char hex string.
pub fn sha256(data: text) -> text {
  out = zeros(32);
  c_sha256_text(data, out);
  hex(out)
}

// SHA-256 of the RAW BYTES decoded from base64 `data_b64`. Returns base64 of the
// 32-byte digest, or "" when `data_b64` is not base64. Use this to hash arbitrary
// byte strings (ciphertext, canonical CBOR) that are not valid UTF-8 and so cannot
// be passed to `sha256` as text.
// Example: @CRY-001 — the two hashing doors: text in / hex out vs base64 both ways.
pub fn sha256_b64(data_b64: text) -> text {
  bytes = b64_decode(data_b64);
  if bytes == null { return ""; }
  out = zeros(32);
  c_sha256(bytes, out);
  b64_encode(out)
}

// HMAC-SHA256 of data with key. Returns 64-char hex string.
pub fn hmac_sha256(key: text, data: text) -> text {
  out = zeros(32);
  c_hmac_sha256_text(key, data, out);
  hex(out)
}

// Base64 encode a string.
pub fn base64_encode(data: text) -> text {
  b64_encode(text_bytes(data))
}

// Base64 decode to text.  "" when `data` is not base64, or when its bytes are not
// UTF-8 — those are not text; `base64_to_bytes` reads them.
pub fn base64_decode(data: text) -> text {
  bytes = b64_decode(data);
  if bytes == null { return ""; }
  text_from_bytes(bytes)
}

// Base64url encode (JWT-safe, no padding).
pub fn base64url_encode(data: text) -> text {
  b64url_encode(text_bytes(data))
}

// --- Ed25519 signatures (RFC 8032) ---
//
// All key / message / signature bytes are standard base64 `text`.  A secret
// key is the RFC 8032 32-byte seed (base64); the public key (32B) and
// signature (64B) are the canonical encodings.  Malformed input never halts:
// `ed25519_public_key` / `ed25519_sign` return "" and `ed25519_verify`
// returns false.

// Derive the 32-byte public key (base64) from a 32-byte secret seed (base64).
pub fn ed25519_public_key(secret_key_b64: text) -> text {
  seed = b64_fixed(secret_key_b64, 32);
  if seed == null { return ""; }
  out = zeros(32);
  c_ed25519_public_key(seed, out);
  b64_encode(out)
}

// Sign the base64 `message` bytes with the 32-byte secret seed (base64).
// Returns the 64-byte signature, base64.
// Example: @CRY-002 — sign `base64_encode(msg)`; the bare text signs other bytes, silently.
pub fn ed25519_sign(secret_key_b64: text, message_b64: text) -> text {
  seed = b64_fixed(secret_key_b64, 32);
  if seed == null { return ""; }
  message = b64_decode(message_b64);
  if message == null { return ""; }
  out = zeros(64);
  c_ed25519_sign(seed, message, out);
  b64_encode(out)
}

// Verify a signature over the base64 `message` bytes under a public key.
// Returns true iff the signature is valid.
// Example: @CRY-002 — why a wrongly-spelled message still verifies against itself.
pub fn ed25519_verify(public_key_b64: text, message_b64: text, signature_b64: text) -> boolean {
  public = b64_fixed(public_key_b64, 32);
  if public == null { return false; }
  signature = b64_fixed(signature_b64, 64);
  if signature == null { return false; }
  message = b64_decode(message_b64);
  if message == null { return false; }
  c_ed25519_verify(public, message, signature)
}

// --- ES256 signatures (ECDSA P-256 / SHA-256, JOSE `alg: ES256`) ---
//
// The signature RFC 8555 ACME requires for account keys and CSRs — Let's Encrypt
// rejects Ed25519 account keys, so ES256 cannot be replaced by the ed25519 path.
// All bytes are standard base64 `text`.  A secret key is the 32-byte P-256 scalar
// `d`; a public key is the 64-byte affine point `x || y` (the JWK coordinates,
// no 0x04 SEC1 prefix); a signature is the 64-byte raw `r || s` (the JOSE form —
// the DER encoding is for the X.509/PKCS#10 layer, never for a JWS signature).
// Signing is deterministic (RFC 6979), so the same key + message always signs to
// the same bytes; only `keygen` draws entropy.  Malformed input never halts:
// `ecdsa_p256_keygen` / `_public_key` / `_sign` return "" and `_verify` false.

// Generate a fresh 32-byte P-256 secret scalar (base64) from the OS CSPRNG.
pub fn ecdsa_p256_keygen() -> text {
  seed = zeros(32);
  if c_random(seed) == 0 { return ""; }
  if c_p256_scalar_ok(seed) { return b64_encode(seed); }
  // A seed outside the group order is hashed into it, as the Rust part did.
  d = zeros(32);
  c_sha256(seed, d);
  if c_p256_scalar_ok(d) { return b64_encode(d); }
  ""
}

// Derive the 64-byte public key `x || y` (base64) from a 32-byte secret scalar (base64).
// Example: @CRY-003 — the three JOSE lengths (32 / 64 / 64) a caller should check.
pub fn ecdsa_p256_public_key(secret_key_b64: text) -> text {
  d = b64_fixed(secret_key_b64, 32);
  if d == null { return ""; }
  out = zeros(64);
  if c_p256_public_key(d, out) == 0 { return ""; }
  b64_encode(out)
}

// Sign the base64 `message` bytes with the 32-byte secret scalar (base64).
// Returns the 64-byte `r || s` signature (base64), deterministic per RFC 6979.
// Example: @CRY-003 — signing twice answers identical bytes, and `r || s` is not DER.
pub fn ecdsa_p256_sign(secret_key_b64: text, message_b64: text) -> text {
  d = b64_fixed(secret_key_b64, 32);
  if d == null { return ""; }
  message = b64_decode(message_b64);
  if message == null { return ""; }
  out = zeros(64);
  if c_p256_sign(d, message, out) == 0 { return ""; }
  b64_encode(out)
}

// Verify an ES256 signature (64-byte `r || s`) over the base64 `message` bytes
// under a 64-byte `x || y` public key.  Returns true iff the signature is valid.
pub fn ecdsa_p256_verify(public_key_b64: text, message_b64: text, signature_b64: text) -> boolean {
  xy = b64_fixed(public_key_b64, 64);
  if xy == null { return false; }
  signature = b64_fixed(signature_b64, 64);
  if signature == null { return false; }
  message = b64_decode(message_b64);
  if message == null { return false; }
  c_p256_verify(xy, message, signature)
}

// --- X25519 key agreement (RFC 7748) ---
//
// A secret key is a 32-byte X25519 scalar (base64); a public key is the
// 32-byte u-coordinate (base64).  Returns the raw 32-byte shared secret
// (base64), or "" if either input is the wrong length.  Run the result
// through `hkdf_sha256` before using it as a key (RFC 7748 §6.1).
// Example: @CRY-004 — the DH output is keying material, not a key; and how to get a
// public key out of a secret scalar (X25519 has no separate keygen).
pub fn x25519_dh(secret_key_b64: text, public_key_b64: text) -> text {
  secret = b64_fixed(secret_key_b64, 32);
  if secret == null { return ""; }
  public = b64_fixed(public_key_b64, 32);
  if public == null { return ""; }
  out = zeros(32);
  if c_x25519(secret, public, out) == 0 { return ""; }
  b64_encode(out)
}

// --- HKDF-SHA256 key derivation (RFC 5869) ---
//
// Derive `length` bytes of output keying material from `ikm`, `salt`, and
// `info` (each base64).  An empty base64 `salt` selects the all-zero salt.
// Returns the base64 OKM, or "" if `length` exceeds 255*32 or is <= 0, or an
// argument is not base64.
// Example: @CRY-004 — `info` is what separates two keys from one shared secret.
pub fn hkdf_sha256(salt_b64: text, ikm_b64: text, info_b64: text, length: integer) -> text {
  if length <= 0 || length > 8160 { return ""; }
  salt = b64_decode(salt_b64);
  ikm = b64_decode(ikm_b64);
  info = b64_decode(info_b64);
  if salt == null { return ""; }
  if ikm == null { return ""; }
  if info == null { return ""; }
  out = zeros(length);
  if c_hkdf(salt, ikm, info, out) == 0 { return ""; }
  b64_encode(out)
}

// HKDF-Extract (RFC 5869 §2.2): the 32-byte PRK (base64) HMAC-SHA256(salt, ikm).
// An empty base64 `salt` selects the all-zero salt; "" when an argument is not
// base64.  Use the Extract/Expand
// halves directly (rather than `hkdf_sha256`) when a PRK is reused for several
// Expands or when an Extract output is itself the value you want (e.g. HPKE).
// Example: @CRY-004 — the split halves compose to exactly `hkdf_sha256`.
pub fn hkdf_extract(salt_b64: text, ikm_b64: text) -> text {
  salt = b64_decode(salt_b64);
  ikm = b64_decode(ikm_b64);
  if salt == null { return ""; }
  if ikm == null { return ""; }
  out = zeros(32);
  c_hkdf_extract(salt, ikm, out);
  b64_encode(out)
}

// HKDF-Expand (RFC 5869 §2.3) from an existing 32-byte PRK.  Returns `length`
// bytes of OKM (base64), or "" on a short PRK, length > 255*32, length <= 0, or
// an argument that is not base64.
pub fn hkdf_expand(prk_b64: text, info_b64: text, length: integer) -> text {
  if length <= 0 || length > 8160 { return ""; }
  prk = b64_decode(prk_b64);
  info = b64_decode(info_b64);
  if prk == null { return ""; }
  if info == null { return ""; }
  if len(prk) < 32 { return ""; }
  out = zeros(length);
  if c_hkdf_expand(prk, info, out) == 0 { return ""; }
  b64_encode(out)
}

// --- Raw bytes <-> base64 ---
//
// loft `text` is UTF-8-validated, so a non-UTF-8 byte string cannot ride as
// `text` (`text_from_bytes` returns "").  These two inverse helpers move raw
// bytes across the base64 boundary instead.  The vector `base64_to_bytes`
// answers is an ordinary one: read it, append to it, pass it on.

// Standard base64 of a raw byte vector.  Empty vector -> "".
pub fn bytes_to_base64(bytes: vector<u8>) -> text {
  b64_encode(bytes)
}

// Raw bytes from standard base64.  Input that is not base64, or empty, -> empty vector.
// Example: @CRY-001 — reading a decoded byte vector, and hashing non-UTF-8 bytes.
pub fn base64_to_bytes(b64: text) -> vector<u8> {
  b64_decode(b64) ?? []
}

// --- AES-256-GCM authenticated encryption ---
//
// All byte arguments are base64.  The key is 32 bytes and the nonce is 12
// bytes (the standard 96-bit GCM IV).  A nonce MUST NOT be reused under one
// key — derive a fresh one per message (e.g. random_bytes(12)).

// Encrypt + authenticate `plaintext` under `key`/`nonce`, binding `aad`.
// Returns base64 of ciphertext WITH the 16-byte tag appended, or "" on bad
// key/nonce length or an argument that is not base64.
// Example: @CRY-005 — the tag rides in the blob, and a fresh nonce per message.
pub fn aes256gcm_seal(key_b64: text, nonce_b64: text, aad_b64: text, plaintext_b64: text) -> text {
  key = b64_fixed(key_b64, 32);
  nonce = b64_fixed(nonce_b64, 12);
  if key == null { return ""; }
  if nonce == null { return ""; }
  aad = b64_decode(aad_b64);
  buf = b64_decode(plaintext_b64);
  if aad == null { return ""; }
  if buf == null { return ""; }
  tag = zeros(16);
  c_aes256gcm(1, key, nonce, aad, buf, tag);
  buf += tag;
  b64_encode(buf ?? [])
}

// Verify + decrypt `ciphertext` (ciphertext||tag, base64) under `key`/`nonce`,
// binding `aad`.  Returns the base64 plaintext, or "" on ANY authentication
// failure — an empty result means the ciphertext/tag/aad did not verify.
// Example: @CRY-005 — "" is a failure signal, and an authentic empty plaintext gives it too.
pub fn aes256gcm_open(key_b64: text, nonce_b64: text, aad_b64: text, ciphertext_b64: text) -> text {
  key = b64_fixed(key_b64, 32);
  nonce = b64_fixed(nonce_b64, 12);
  if key == null { return ""; }
  if nonce == null { return ""; }
  aad = b64_decode(aad_b64);
  ct = b64_decode(ciphertext_b64);
  if aad == null { return ""; }
  if ct == null { return ""; }
  n = len(ct);
  if n < 16 { return ""; }
  buf = ct[0..n - 16];
  tag = ct[n - 16..n];
  if c_aes256gcm(0, key, nonce, aad, buf, tag) == 0 { return ""; }
  b64_encode(buf)
}

// --- CSPRNG ---

// Return `length` cryptographically secure random bytes (base64) from the OS
// RNG.  Returns "" for length <= 0.  Use for keys (32), nonces (12), salts.
pub fn random_bytes(length: integer) -> text {
  if length <= 0 { return ""; }
  out = zeros(length);
  if c_random(out) == 0 { return ""; }
  b64_encode(out)
}


// ====================================================================
// HPKE — Hybrid Public Key Encryption, base mode (RFC 9180)
// ====================================================================
//
// Single-shot Seal/Open for the ciphersuite
//   DHKEM(X25519, HKDF-SHA256) / HKDF-SHA256 / AES-256-GCM
//   kem_id = 0x0020, kdf_id = 0x0001, aead_id = 0x0002, mode = 0x00 (base).
//
// This is a PURE-LOFT composition over the native primitives above (X25519,
// HKDF Extract/Expand, AES-256-GCM), so it runs identically on every backend
// the primitives reach.  Correctness is gated on an RFC 9180 known-answer test
// vector (see tests/hpke.loft).
//
// Byte composition stays entirely in base64 `text`: every byte chunk (labels,
// suite ids, keys, DH outputs) is a base64 string, and `bytes_concat_b64`
// concatenates the underlying raw bytes.  ASCII labels are base64-encoded with
// the existing `base64_encode` (ASCII is valid UTF-8), so every intermediate is
// the base64 text the primitives take and answer.

// base64(bytes(a) || bytes(b)) — concatenate two base64 byte strings.
fn concat(a_b64: text, b_b64: text) -> text {
  a = b64_decode(a_b64);
  b = b64_decode(b_b64);
  if a == null { return ""; }
  if b == null { return ""; }
  a += b;
  b64_encode(a ?? [])
}

// An ASCII label as a base64 byte string (ASCII is valid UTF-8, so this is the
// plain text base64 encoder).
fn label_b64(s: text) -> text {
  b64_encode(text_bytes(s))
}

// I2OSP(n, 2) as base64: the 2-byte big-endian encoding of `n` (RFC 8017).
// Only the small fixed set HPKE needs (suite-id fields and the L lengths 32/12)
// is required here, so each is a precomputed base64 constant — no `vector<u8>`.
fn i2osp_2_b64(n: integer) -> text {
  if n == 0x0020 { return "ACA="; }   // 0x00 0x20  (kem_id, and L = 32)
  if n == 0x0001 { return "AAE="; }   // 0x00 0x01  (kdf_id)
  if n == 0x0002 { return "AAI="; }   // 0x00 0x02  (aead_id)
  if n == 12     { return "AAw="; }   // 0x00 0x0c  (L = 12, base nonce)
  ""
}

// The main HPKE suite_id (base64): "HPKE" || I2OSP(kem,2) || I2OSP(kdf,2) || I2OSP(aead,2).
fn hpke_suite_id_b64() -> text {
  s = concat(label_b64("HPKE"), i2osp_2_b64(0x0020));  // + kem_id
  s = concat(s, i2osp_2_b64(0x0001));                  // + kdf_id
  concat(s, i2osp_2_b64(0x0002))                       // + aead_id
}

// The DHKEM suite_id (base64): "KEM" || I2OSP(kem_id,2).
fn kem_suite_id_b64() -> text {
  concat(label_b64("KEM"), i2osp_2_b64(0x0020))
}

// LabeledExtract(salt, label, ikm) [RFC 9180 §4]:
//   labeled_ikm = "HPKE-v1" || suite_id || label || ikm
//   return HKDF-Extract(salt, labeled_ikm)
// All byte args are base64.  Returns the 32-byte PRK (base64).
fn labeled_extract(suite_id_b64: text, salt_b64: text, label: text, ikm_b64: text) -> text {
  li = concat(label_b64("HPKE-v1"), suite_id_b64);
  li = concat(li, label_b64(label));
  li = concat(li, ikm_b64);
  hkdf_extract(salt_b64, li)
}

// LabeledExpand(prk, label, info, L) [RFC 9180 §4]:
//   labeled_info = I2OSP(L,2) || "HPKE-v1" || suite_id || label || info
//   return HKDF-Expand(prk, labeled_info, L)
// Returns L bytes (base64).
fn labeled_expand(suite_id_b64: text, prk_b64: text, label: text, info_b64: text, length: integer) -> text {
  li = concat(i2osp_2_b64(length), label_b64("HPKE-v1"));
  li = concat(li, suite_id_b64);
  li = concat(li, label_b64(label));
  li = concat(li, info_b64);
  hkdf_expand(prk_b64, li, length)
}

// DHKEM ExtractAndExpand(dh, kem_context) [RFC 9180 §4.1], KEM suite_id:
//   eae_prk       = LabeledExtract("", "eae_prk", dh)
//   shared_secret = LabeledExpand(eae_prk, "shared_secret", kem_context, Nsecret=32)
// Returns the 32-byte shared secret (base64).
fn dhkem_extract_and_expand(dh_b64: text, kem_context_b64: text) -> text {
  ks = kem_suite_id_b64();
  eae_prk = labeled_extract(ks, "", "eae_prk", dh_b64);
  labeled_expand(ks, eae_prk, "shared_secret", kem_context_b64, 32)
}

// The X25519 base point (base64): 0x09 followed by 31 zero bytes (RFC 7748).
// `x25519_dh(sk, base_point)` yields sk's public key.
const X25519_BASE_POINT = "CQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";

// The X25519 public key for secret scalar `sk_b64`: X25519(sk, base_point).
fn x25519_public_key(sk_b64: text) -> text {
  x25519_dh(sk_b64, X25519_BASE_POINT)
}

// DHKEM Decap(enc, skR) [RFC 9180 §4.1]:
//   dh          = DH(skR, enc);  pkRm = pk(skR)
//   kem_context = enc || pkRm
//   return ExtractAndExpand(dh, kem_context)
// Returns the 32-byte shared secret (base64), or "" if enc/skR are invalid.
fn dhkem_decap(enc_b64: text, sk_r_b64: text) -> text {
  dh_b64 = x25519_dh(sk_r_b64, enc_b64);
  if dh_b64 == "" { return ""; }
  pk_r_b64 = x25519_public_key(sk_r_b64);
  kem_context = concat(enc_b64, pk_r_b64);
  dhkem_extract_and_expand(dh_b64, kem_context)
}

// DHKEM Encap(pkR, skE) — the deterministic variant [RFC 9180 §4.1].  Takes a
// fixed ephemeral secret `sk_e_b64` (the KAT path); `hpke_seal_base` generates
// a random one.
//   pkEm = pk(skE);  dh = DH(skE, pkR);  enc = pkEm
//   kem_context = enc || pkR
//   return (ExtractAndExpand(dh, kem_context), enc)
// Returns (shared_secret_b64, enc_b64); ("","") on invalid input.
fn dhkem_encap_deterministic(pk_r_b64: text, sk_e_b64: text) -> (text, text) {
  enc_b64 = x25519_public_key(sk_e_b64);
  if enc_b64 == "" { return ("", ""); }
  dh_b64 = x25519_dh(sk_e_b64, pk_r_b64);
  if dh_b64 == "" { return ("", ""); }
  kem_context = concat(enc_b64, pk_r_b64);
  shared_secret = dhkem_extract_and_expand(dh_b64, kem_context);
  (shared_secret, enc_b64)
}

// KeySchedule for base mode (RFC 9180 §5.1), MAIN suite_id.  Returns the AEAD
// key (32 bytes) and base nonce (12 bytes) as (key_b64, nonce_b64).
//   psk_id_hash          = LabeledExtract("", "psk_id_hash", "")
//   info_hash            = LabeledExtract("", "info_hash", info)
//   key_schedule_context = 0x00 || psk_id_hash || info_hash
//   secret               = LabeledExtract(shared_secret, "secret", "")
//   key        = LabeledExpand(secret, "key", key_schedule_context, Nk=32)
//   base_nonce = LabeledExpand(secret, "base_nonce", key_schedule_context, Nn=12)
fn key_schedule_base(shared_secret_b64: text, info_b64: text) -> (text, text) {
  s = hpke_suite_id_b64();

  psk_id_hash = labeled_extract(s, "", "psk_id_hash", "");
  info_hash = labeled_extract(s, "", "info_hash", info_b64);

  // key_schedule_context = mode (0x00) || psk_id_hash || info_hash.
  // The single 0x00 mode byte as base64 is "AA==".
  ks_context = concat("AA==", psk_id_hash);
  ks_context = concat(ks_context, info_hash);

  // secret = LabeledExtract(shared_secret, "secret", "")  — shared_secret is the salt.
  secret = labeled_extract(s, shared_secret_b64, "secret", "");

  key = labeled_expand(s, secret, "key", ks_context, 32);
  base_nonce = labeled_expand(s, secret, "base_nonce", ks_context, 12);
  (key, base_nonce)
}

// The result of `hpke_seal_base`: the KEM-encapsulated key `enc` and the AEAD
// `ciphertext` (ciphertext||16-byte-tag), both base64.
pub struct HpkeSealed {
  pub const enc: text,
  pub const ciphertext: text,
}

// Internal: seal with an already-encapsulated (shared_secret, enc).  seq = 0,
// so the AEAD nonce is exactly base_nonce (RFC 9180 §5.2).
fn seal_with_context(shared_secret_b64: text, enc_b64: text, info_b64: text, aad_b64: text, pt_b64: text) -> HpkeSealed {
  (key, base_nonce) = key_schedule_base(shared_secret_b64, info_b64);
  if key == "" || base_nonce == "" { return HpkeSealed { enc: "", ciphertext: "" }; }
  ct = aes256gcm_seal(key, base_nonce, aad_b64, pt_b64);
  HpkeSealed { enc: enc_b64, ciphertext: ct }
}

// --- Public HPKE API ---

// HPKE SealBase (RFC 9180 §6.1): encrypt `pt` to recipient public key `pk_r`,
// binding `info` (key-schedule context) and `aad` (per-message AAD).  Generates
// a fresh ephemeral key, so each call's output differs.  All args/fields base64.
// Returns HpkeSealed { enc, ciphertext }; both "" on failure.
// Example: @CRY-006 — `enc` is fresh per call and must travel with the ciphertext.
pub fn hpke_seal_base(pk_r_b64: text, info_b64: text, aad_b64: text, pt_b64: text) -> HpkeSealed {
  sk_e_b64 = random_bytes(32);
  (shared_secret, enc) = dhkem_encap_deterministic(pk_r_b64, sk_e_b64);
  if shared_secret == "" { return HpkeSealed { enc: "", ciphertext: "" }; }
  seal_with_context(shared_secret, enc, info_b64, aad_b64, pt_b64)
}

// Deterministic SealBase — TEST ONLY.  Uses the caller-supplied ephemeral
// secret `sk_e_b64` instead of a random one, so the output is reproducible
// against an RFC 9180 known-answer vector.  Never use in production.
pub fn hpke_seal_base_deterministic(pk_r_b64: text, sk_e_b64: text, info_b64: text, aad_b64: text, pt_b64: text) -> HpkeSealed {
  (shared_secret, enc) = dhkem_encap_deterministic(pk_r_b64, sk_e_b64);
  if shared_secret == "" { return HpkeSealed { enc: "", ciphertext: "" }; }
  seal_with_context(shared_secret, enc, info_b64, aad_b64, pt_b64)
}

// HPKE OpenBase (RFC 9180 §6.1): decrypt `ct` for recipient secret key `sk_r`
// using the sender's `enc`, binding `info` and `aad`.  All args base64.  Returns
// the base64 plaintext, or "" on ANY failure (bad enc/key or AEAD auth failure).
// Example: @CRY-006 — `info` AND `aad` must both match the sender's, or open gives "".
pub fn hpke_open_base(sk_r_b64: text, enc_b64: text, info_b64: text, aad_b64: text, ct_b64: text) -> text {
  shared_secret = dhkem_decap(enc_b64, sk_r_b64);
  if shared_secret == "" { return ""; }
  (key, base_nonce) = key_schedule_base(shared_secret, info_b64);
  if key == "" || base_nonce == "" { return ""; }
  aes256gcm_open(key, base_nonce, aad_b64, ct_b64)
}

// Expose the key-schedule outputs for KAT assertions — TEST ONLY.  Given a
// shared secret and base64 `info`, returns (key_b64, base_nonce_b64).
pub fn hpke_key_schedule_base_for_test(shared_secret_b64: text, info_b64: text) -> (text, text) {
  key_schedule_base(shared_secret_b64, info_b64)
}

// Expose deterministic Encap for KAT assertions — TEST ONLY.  Returns
// (shared_secret_b64, enc_b64).
pub fn hpke_encap_deterministic_for_test(pk_r_b64: text, sk_e_b64: text) -> (text, text) {
  dhkem_encap_deterministic(pk_r_b64, sk_e_b64)
}
