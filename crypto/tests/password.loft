//
// Argon2id password hashing, the constant-time compare and the X25519 refusal of a
// small-order point.  The Argon2id answers were computed with OpenSSL 3.6's ARGON2ID KDF,
// an implementation independent of the vendored Monocypher, and are spelled as PHC strings.

use crypto::*;

// At the cost `password_hash` uses (19 MiB, two passes, one lane).
fn test_password_verify_an_independent_vector() {
  stored = "$argon2id$v=19$m=19456,t=2,p=1$c29tZXNhbHRzb21lc2FsdA$leF08Fu/gOi7XGf5NvDjbfR9GY+siUuPd+cKkq57H/c";
  good = "hunter2";
  bad = "hunter3";
  assert(crypto::password_verify(good, stored), "the password the vector was made from verifies");
  assert(!crypto::password_verify(bad, stored), "another password does not");
}

// Two lanes and a 16-byte hash: the cost is read from the stored text.
fn test_password_verify_reads_the_cost_from_the_text() {
  stored = "$argon2id$v=19$m=64,t=1,p=2$c2FsdHNhbHQ$2GTFPMOmEV+UV1IqOlfUUw";
  good = "password";
  assert(crypto::password_verify(good, stored), "a hash made with other costs verifies");
}

fn test_password_hash_round_trip() {
  pw = "correct horse battery staple";
  a = crypto::password_hash(pw);
  b = crypto::password_hash(pw);
  assert(a.starts_with("$argon2id$v=19$m=19456,t=2,p=1$"), "a PHC string: {a}");
  assert(a != b, "each hash has a fresh salt");
  assert(crypto::password_verify(pw, a) && crypto::password_verify(pw, b), "both verify");
  other = "correct horse battery stapler";
  assert(!crypto::password_verify(other, a), "another password does not");
}

// Anything that is not an Argon2id PHC string within the limits is refused, not run.
fn test_password_verify_refuses_what_it_cannot_read() {
  pw = "password";
  assert(!crypto::password_verify(pw, ""), "an empty text");
  assert(!crypto::password_verify(pw, "$argon2i$v=19$m=64,t=1,p=2$c2FsdHNhbHQ$2GTFPMOmEV+UV1IqOlfUUw"), "another variant");
  assert(!crypto::password_verify(pw, "$argon2id$v=16$m=64,t=1,p=2$c2FsdHNhbHQ$2GTFPMOmEV+UV1IqOlfUUw"), "another version");
  assert(!crypto::password_verify(pw, "$argon2id$v=19$m=4194304,t=1,p=1$c2FsdHNhbHQ$2GTFPMOmEV+UV1IqOlfUUw"), "4 GiB of memory");
  assert(!crypto::password_verify(pw, "$argon2id$v=19$m=64,t=1000,p=2$c2FsdHNhbHQ$2GTFPMOmEV+UV1IqOlfUUw"), "a thousand passes");
  assert(!crypto::password_verify(pw, "$argon2id$v=19$m=8,t=1,p=2$c2FsdHNhbHQ$2GTFPMOmEV+UV1IqOlfUUw"), "fewer blocks than lanes need");
  assert(!crypto::password_verify(pw, "$argon2id$v=19$m=64,t=1,p=2$c2FsdA$2GTFPMOmEV+UV1IqOlfUUw"), "a 4-byte salt");
  assert(!crypto::password_verify(pw, "$argon2id$v=19$m=64,t=1,p=2$c2FsdHNhbHQ$!!"), "a hash that is not base64");
  assert(!crypto::password_verify(pw, "$argon2id$v=19$m=x4,t=1,p=2$c2FsdHNhbHQ$2GTFPMOmEV+UV1IqOlfUUw"), "a cost that is not a number");
}

fn test_constant_time_equal() {
  a = "0123456789abcdef";
  b = "0123456789abcdef";
  c = "0123456789abcdee";
  d = "0123456789abcde";
  e = "";
  f = "a\0b";
  g = "a\0c";
  assert(crypto::constant_time_equal(a, b), "equal texts");
  assert(!crypto::constant_time_equal(a, c), "the last byte differs");
  assert(!crypto::constant_time_equal(a, d), "a different length");
  assert(crypto::constant_time_equal(e, e), "two empty texts");
  assert(!crypto::constant_time_equal(f, g), "a byte past a NUL counts");
}

// RFC 4231 test case 2.
fn test_hmac_sha256_verify() {
  key = "Jefe";
  data = "what do ya want for nothing?";
  good = "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843";
  bad = "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3844";
  short = "5bdcc146";
  assert(crypto::hmac_sha256_verify(key, data, good), "the RFC's MAC verifies");
  assert(!crypto::hmac_sha256_verify(key, data, bad), "a MAC one bit off does not");
  assert(!crypto::hmac_sha256_verify(key, data, short), "nor a prefix of it");
}

// A public key of small order makes every secret answer the all-zero point (RFC 7748 § 6.1):
// that is no shared secret, and x25519_dh refuses it.
fn test_x25519_refuses_a_small_order_point() {
  sk = "dwdtCnMYpX08FsFyUbJmRd9ML4frwJkqsXf7pR25LCo=";
  zero = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
  one = "AQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
  assert(crypto::x25519_dh(sk, zero) == "", "the point 0");
  assert(crypto::x25519_dh(sk, one) == "", "the point 1");
}
